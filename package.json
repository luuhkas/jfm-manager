{
  "name": "jfm-manager",
  "version": "0.1.0",
  "description": "Sistema desktop para gestão interna e controle de ordens de serviço da JF Mecatrônica.",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "concurrently -k \"npm --prefix renderer run dev\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && env -u ELECTRON_RUN_AS_NODE cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "rebuild:native": "npm rebuild better-sqlite3",
    "test:main": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/main-ipc.test.js",
    "test": "npm --prefix renderer run test && npm run test:main",
    "build": "npm --prefix renderer run build",
    "dist": "npm run build && electron-builder"
  },
  "author": "Lucas Maués",
  "license": "MIT",
  "build": {
    "appId": "br.com.jfmmanager.app",
    "productName": "JFM Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "renderer/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "icon": "build/icon",
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
